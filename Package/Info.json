{
  "pkgId": "lzup.lightsandshadows",
  "name": "光影 Lights And Shadows",
  "author": "lzup333/liuxin",
  "description": "感谢yiyang233大佬提供思路",
  "version": "2.6.1-light",
  "versionCode": 13,
  "detailedInformationURL": "",
  "updateURL": "",
  "dependence": [],
  "support": {
    "android": {
      "arm64": true,
      "arm": false
    },
    "windows": {
      "x64": false,
      "x86": false
    },
    "linux": {
      "x64": false,
      "x86": false
    },
    "mac": {
      "x64": false,
      "x86": false
    }
  },
  "settings": [
    {
      "key": "enabled",
      "title": "启用光影",
      "description": "关闭后完全不介入渲染",
      "type": "SWITCH",
      "defaultValue": true,
      "section": "常规"
    },
    {
      "key": "quality",
      "title": "画质档位",
      "description": "性能最省、视觉最细；选「自定义」时使用下面四项",
      "type": "CHOICE",
      "defaultValue": "balanced",
      "options": [
        {
          "value": "perf",
          "label": "性能"
        },
        {
          "value": "balanced",
          "label": "平衡"
        },
        {
          "value": "visual",
          "label": "视觉"
        },
        {
          "value": "custom",
          "label": "自定义"
        }
      ],
      "section": "常规"
    },
    {
      "key": "shadow_strength",
      "title": "阴影强度",
      "description": "越高阴影越重；100 为基准，默认 135",
      "type": "INTEGER",
      "defaultValue": 135,
      "min": 50,
      "max": 250,
      "step": 5,
      "unit": "%",
      "section": "常规"
    },
    {
      "key": "light_color",
      "title": "光色",
      "description": "太阳/月亮主光的颜色：黄光更暖，白光更中性",
      "type": "CHOICE",
      "defaultValue": "warm",
      "options": [
        {
          "value": "warm",
          "label": "黄光"
        },
        {
          "value": "white",
          "label": "白光"
        }
      ],
      "section": "常规"
    },
    {
      "key": "ray_samples",
      "title": "光柱采样",
      "description": "仅自定义档生效；越大光柱越细腻、越吃性能",
      "type": "INTEGER",
      "defaultValue": 16,
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "次",
      "section": "自定义"
    },
    {
      "key": "shadow_div",
      "title": "阴影分辨率",
      "description": "仅自定义档生效；数值是画面缩小的倍数，2 最清晰、6 最省",
      "type": "INTEGER",
      "defaultValue": 3,
      "min": 2,
      "max": 6,
      "step": 1,
      "unit": "×",
      "section": "自定义"
    },
    {
      "key": "glow",
      "title": "光晕强度",
      "description": "仅自定义档生效；100 为默认亮度",
      "type": "INTEGER",
      "defaultValue": 60,
      "min": 1,
      "max": 150,
      "step": 5,
      "unit": "%",
      "section": "自定义"
    },
    {
      "key": "rays",
      "title": "光柱强度",
      "description": "仅自定义档生效；100 为默认强度",
      "type": "INTEGER",
      "defaultValue": 55,
      "min": 1,
      "max": 150,
      "step": 5,
      "unit": "%",
      "section": "自定义"
    }
  ]
}
